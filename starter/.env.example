# Copy this file to .env and fill in OPENAI_API_KEY.
# All other values work as-is for a local demo.

DEMO_MODE=1
DJANGO_SECRET_KEY=local-demonstration-change-before-public-use
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required: your OpenAI API key
OPENAI_API_KEY=

# Model used for topic generation and document advice
# gpt-4o-mini works on standard accounts; override if you have access to another model
OPENAI_MODEL=gpt-4o-mini

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
